    [ "esp:25", "r1:2", "green", [] ],
    [ "r1:1", "blink:A", "green", [] ],
    [ "blink:C", "esp:GND.2", "black", [] ],
    [ "esp:26", "r2:2", "blue", [] ],
    [ "r2:1", "pollLed:A", "blue", [] ],
    [ "pollLed:C", "esp:GND.2", "black", [] ],
    [ "esp:4", "r3:2", "red", [] ],
    [ "r3:1", "intLed:A", "red", [] ],
    [ "intLed:C", "esp:GND.2", "black", [] ],
    [ "pollBtn:1.r", "esp:13", "blue", [] ],
    [ "pollBtn:2.r", "esp:GND.1", "black", [] ],
    [ "intBtn:1.r", "esp:14", "red", [] ],
    [ "intBtn:2.r", "esp:GND.1", "black", [] ]
